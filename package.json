{
  "name": "pi-tsgw",
  "version": "3.8.1",
  "description": "面向 TOSSP AIH gateway 的 Pi 扩展：按厂商维护聊天与图片模型目录及思考策略，支持四种聊天协议、图片生成与编辑工具，以及原生 System One 分类模型。",
  "type": "module",
  "keywords": [
    "pi",
    "pi-package",
    "tsgw",
    "gateway",
    "models"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tossp/pi-tsgw.git"
  },
  "imports": {
    "#tsgw/*": "./extensions/*.ts",
    "#tsgw-prompts/*": "./prompts/*.ts"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "scripts": {
    "test": "tsc -p tsconfig.test.json && node scripts/prepare-test-runtime.mjs && node scripts/run-tests.mjs",
    "test:upload:live": "tsc -p tsconfig.test.json && node scripts/prepare-test-runtime.mjs && node dist/extensions/upload/live.test.js"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=1.2.0",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.5.2",
    "@earendil-works/pi-coding-agent": "1.5.2",
    "@earendil-works/pi-mcp": "1.5.2",
    "@types/html-to-text": "9.0.4",
    "typebox": "^1.3.37",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "html-to-text": "10.0.1",
    "imapflow": "2.9.1",
    "nodemailer": "10.3.1"
  },
  "optionalDependencies": {
    "davkit": "0.3.0"
  }
}
