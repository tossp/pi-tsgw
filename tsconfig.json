{
  "compilerOptions": {
    "target": "es2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "strict": true,
    "noEmitOnError": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": ".",
    "paths": {
      "#tsgw/*": ["./extensions/*.ts"],
      "#tsgw-prompts/*": ["./prompts/*.ts"]
    }
  },
  "include": ["index.ts", "extensions", "prompts"],
  "exclude": ["**/*.test.ts"]
}
